# Copy this file to .streamlit/secrets.toml and fill in your Firebase web app config.
# Get the values with:  npx firebase-tools apps:sdkconfig WEB --project <project-id>
# On Streamlit Community Cloud, paste the same content into App settings -> Secrets.
[firebase]
api_key = "YOUR_FIREBASE_WEB_API_KEY"
project_id = "your-firebase-project-id"
