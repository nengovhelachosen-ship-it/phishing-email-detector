rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: Firebase Auth uid of the owner
// Fields:
//   - email: string (required, must equal the signed-in user's token email)
//   - displayName: string (required, 0-60 chars)
//   - createdAt: timestamp (required, server time on create, immutable)
//
// Collection: users/{userId}/history
// Document ID: random id generated by the client
// Entries are immutable: they can be created, read and deleted, never updated.
// Fields:
//   - createdAt: timestamp (required, server request time)
//   - inputMethod: string (required, 'paste' | 'screenshot' | 'text_file')
//   - source: string (required, 0-200 chars)
//   - modelName: string (required, 1-40 chars)
//   - modelPrediction: string (required, 'PHISHING' | 'SAFE')
//   - phishingProbability: number 0-1 or null (required)
//   - finalResult: string (required, 'PHISHING' | 'POTENTIALLY SUSPICIOUS' | 'SAFE')
//   - ruleScore: int (required, 0-100)
//   - reasons: list of strings (required, max 20 items)
//   - emailText: string (required, 0-20000 chars)
//   - hasImage: bool (required, true only when imageBase64 is present)
//   - imageBase64: string (optional, 1-900000 chars, base64 JPEG/PNG screenshot)
//   - imageMime: string (optional, 'image/jpeg' | 'image/png', present with imageBase64)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'createdAt'])
        && data.email is string
        && request.auth.token.email != null
        && data.email == request.auth.token.email
        && isValidString(data.displayName, 0, 60)
        && data.createdAt is timestamp;
    }

    function isValidReasons(reasons) {
      return reasons is list && reasons.size() <= 20;
    }

    function isValidImage(data) {
      return (data.hasImage == false
                && !('imageBase64' in data)
                && !('imageMime' in data))
        || (data.hasImage == true
                && isValidString(data.imageBase64, 1, 900000)
                && data.imageMime in ['image/jpeg', 'image/png']);
    }

    function isValidHistoryEntry(data) {
      return data.keys().hasAll([
          'createdAt', 'inputMethod', 'source', 'modelName', 'modelPrediction',
          'phishingProbability', 'finalResult', 'ruleScore', 'reasons',
          'emailText', 'hasImage'
        ])
        && data.keys().hasOnly([
          'createdAt', 'inputMethod', 'source', 'modelName', 'modelPrediction',
          'phishingProbability', 'finalResult', 'ruleScore', 'reasons',
          'emailText', 'hasImage', 'imageBase64', 'imageMime'
        ])
        && data.createdAt == request.time
        && data.inputMethod in ['paste', 'screenshot', 'text_file']
        && isValidString(data.source, 0, 200)
        && isValidString(data.modelName, 1, 40)
        && data.modelPrediction in ['PHISHING', 'SAFE']
        && (data.phishingProbability == null
              || (data.phishingProbability is number
                    && data.phishingProbability >= 0
                    && data.phishingProbability <= 1))
        && data.finalResult in ['PHISHING', 'POTENTIALLY SUSPICIOUS', 'SAFE']
        && data.ruleScore is int && data.ruleScore >= 0 && data.ruleScore <= 100
        && isValidReasons(data.reasons)
        && isValidString(data.emailText, 0, 20000)
        && data.hasImage is bool
        && isValidImage(data);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /history/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHistoryEntry(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
